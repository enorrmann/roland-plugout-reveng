#!/bin/sh
# s1cc driver (docs/S1CC.md §9): C / C++ voice program -> kernel for the Roland BMC DSPs.
#
#   sdk/s1cc/s1cc build VOICE.cc [MORE.cc ...] [-I DIR ...] [-o OUTDIR] [--tol X] [--tollog X] [--maxdeg N] [--regs LIST]
#           [--debug] [--check] [--no-auto]
#       OUTDIR (default build/<voice>): voice.ll (linked IR), tables.txt (S1_PARAM tables), profile.txt,
#       voice.s1k (the kernel), report.txt; ref / prof / refdsp (native reference, profiling, reference that
#       starts from the DSP's initial state). --debug (or S1CC_DEBUG=1): C file:line and function in every error,
#       and first the list of C functions s1cc cannot compile and why (OUTDIR/diag.txt); S1CC_DEBUG=2 adds every node.
#       --check: `check OUTDIR` at the end (instructions, SNR against the native reference; note 57, knobs at 128)
#       --regs LIST: the DSP registers the kernel may use (default 0,1,2,3,4,7: MUTABLE-SYSTEM's host keeps r5 / r6;
#       SYSTEM-S1CC has no host: 0,1,2,3,4,5,6,7, fewer spills; docs/S1CC.md §1.1)
#       Sources: the ones given, plus the source next to every header they include (saw.h -> saw.c,
#       braids/resources.h -> braids/resources.cc), and so on; --no-auto: only the ones given
#   sdk/s1cc/s1cc check OUTDIR [--note N] [name=knob ...]   microcode on the emulator vs the native reference
#   sdk/s1cc/s1cc deps                       fetch Mutable Instruments' stmlib (MIT) into lib/ (not build/, which may be wiped; the eurorack
#       checkout has its submodule empty): with it, `build` adds -I lib and stmlib's units.cc / random.cc,
#       so Plaits / Rings / Elements / Braids sources compile as they are
#
# Needs clang / clang++ and LLVM 19 (llvm-link), make; `check` needs Python 3 (the repo's assembler and emulator).
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
LLVM_BIN=${LLVM_BIN:-/usr/lib/llvm-19/bin}
CLANG=${CLANG:-clang}
CLANGXX=${CLANGXX:-clang++}
# driver errors carry a code too (docs/S1CC.md §9.2)
fail() { echo "s1cc: error $1: $2" >&2; [ "${S1CC_DEBUG:-0}" = 0 ] || echo "s1cc: debug: cause and fix of $1: docs/S1CC.md §9.2" >&2; exit 1; }
usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ $# -ge 1 ] || usage
cmd=$1; shift
case $cmd in
build)
    srcs=; incs=; out=; lower_opts=; debug=${S1CC_DEBUG:-0}; check=0; auto=1
    while [ $# -gt 0 ]; do
        case $1 in
            -I) incs="$incs -I$2"; shift ;;
            -I*) incs="$incs $1" ;;
            -o) out=$2; shift ;;
            --tol|--tollog|--maxdeg|--maxknots|--regs) lower_opts="$lower_opts $1 $2"; shift ;;
            --trace|--no-exact-init|--no-fold-branches|--no-recipseed) lower_opts="$lower_opts $1" ;;
            --check) check=1 ;;
            --no-auto) auto=0 ;;
            --debug) [ "$debug" -ge 1 ] 2>/dev/null || debug=1 ;;
            -h|--help) usage ;;
            *) srcs="$srcs $1" ;;
        esac
        shift
    done
    [ -n "$srcs" ] || usage
    first=$(echo $srcs | cut -d' ' -f1)
    name=$(basename "$first"); name=${name%.*}
    out=${out:-$HERE/build/$name}
    mkdir -p "$out"
    make -s -C "$HERE" build/s1cc
    dbgflags=
    if [ "$debug" != 0 ]; then
        export S1CC_DEBUG=$debug
        dbgflags=-g                            # debug info: the C function and line of every instruction
    fi
    DEPS=$HERE/lib                                     # third-party sources (s1cc deps): kept out of build/
    if [ -d "$DEPS/stmlib/dsp" ]; then                 # the real stmlib, before any stand-in
        incs="-I$DEPS -DTEST $incs"            # TEST: stmlib's portable C instead of ARM asm
        for s in "$DEPS/stmlib/dsp/units.cc" "$DEPS/stmlib/utils/random.cc"; do
            case " $srcs " in *" $s "*) ;; *) srcs="$srcs $s" ;; esac
        done
    fi
    if [ "$auto" = 1 ]; then
        # the sources next to the headers the program includes (saw.h -> saw.c, braids/resources.h -> resources.cc),
        # then those of the new sources, until nothing new; clang -MM lists the headers it really opens
        seen=; autos=
        for s in $srcs; do seen="$seen $(readlink -f "$s")"; done
        todo=$srcs
        while [ -n "$todo" ]; do
            next=
            for s in $todo; do
                case $s in *.c) cc=$CLANG; std= ;; *) cc=$CLANGXX; std=-std=c++17 ;; esac
                hdrs=$($cc -MM -w $std -I"$HERE/include" $incs "$s" 2>/dev/null | tr -d '\\' | tr ' ' '\n' |
                       grep -E '\.(h|hh|hpp)$' || true)
                for h in $hdrs; do
                    hp=$(readlink -f "$h")
                    case $hp in "$HERE"/include/*) continue ;; esac
                    for ext in c cc cpp; do
                        c=${hp%.*}.$ext
                        [ -f "$c" ] || continue
                        case " $seen " in *" $c "*) continue ;; esac
                        seen="$seen $c"; srcs="$srcs $c"; next="$next $c"; autos="$autos $c"
                        echo "source: $c (for $(basename "$h"); --no-auto to leave it out)"
                    done
                done
            done
            todo=$next
        done
    fi
    lls=; o0s=
    i=0
    for s in $srcs; do
        i=$((i + 1))
        case $s in *.c) cc=$CLANG; std= ;; *) cc=$CLANGXX; std="-std=c++17 -fno-exceptions -fno-rtti" ;; esac
        # an automatic source that does not compile on the PC (firmware: settings.cc needs the STM32 headers) is left
        # out: if the voice needs something from it, the link says so (E011)
        case " $autos " in *" $s "*) errs=/dev/null ;; *) errs=/dev/stderr ;; esac
        if ! $cc -O2 -S -emit-llvm -w -fno-math-errno -mllvm -inline-threshold=100000 -mllvm -jump-threading-threshold=0 -fno-vectorize -fno-slp-vectorize -falign-functions=16 $dbgflags $std -I"$HERE/include" $incs \
            "$s" -o "$out/src$i.ll" 2>$errs; then
            case " $autos " in
                *" $s "*) echo "source: $s left out (it does not compile on the PC)"; continue ;;
                *) fail E010 "clang could not compile $s" ;;
            esac
        fi
        lls="$lls $out/src$i.ll"
        if [ "$debug" != 0 ]; then         # the same at -O0: every instruction at its C line (srcmap.ll)
            $cc -O0 -Xclang -disable-O0-optnone -S -emit-llvm -w -g $std -I"$HERE/include" $incs "$s" -o "$out/src$i.O0.ll"
            o0s="$o0s $out/src$i.O0.ll"
        fi
    done
    "$LLVM_BIN/llvm-link" -S $lls -o "$out/linked0.ll"
    if [ "$debug" != 0 ]; then
        "$LLVM_BIN/llvm-link" -S $o0s -o "$out/srcmap.ll"
        export S1CC_SRCMAP="$out/srcmap.ll"
    fi
    # across sources (a wrapper calling a library's render function): inline everything into the voice functions
    if [ "$debug" != 0 ]; then
        # the inliner's reasons for every call it kept, then what s1cc cannot compile (before any later error)
        "$LLVM_BIN/opt" -S -passes='internalize,default<O2>' -internalize-public-api-list=s1_dsp_a,s1_dsp_b,s1_init,s1_note_range -inline-threshold=100000 -jump-threading-threshold=0 -vectorize-loops=false -vectorize-slp=false \
            -pass-remarks-missed=inline "$out/linked0.ll" -o "$out/linked.ll" 2> "$out/inline.txt" ||
            { cat "$out/inline.txt" >&2; exit 1; }
        "$HERE/build/s1cc" diag "$out/linked.ll" --remarks "$out/inline.txt" > "$out/diag.txt"
        sed 's/^/s1cc: debug: /' "$out/diag.txt" >&2
    else
        "$LLVM_BIN/opt" -S -passes='internalize,default<O2>' -internalize-public-api-list=s1_dsp_a,s1_dsp_b,s1_init,s1_note_range -inline-threshold=100000 -jump-threading-threshold=0 -vectorize-loops=false -vectorize-slp=false \
            "$out/linked0.ll" -o "$out/linked.ll"
    fi
    # indirect calls whose targets are known (a member-function table at a mode a branch chose): direct calls,
    # then O2 again to inline them (docs/S1CC.md §4.7)
    ndv=$("$HERE/build/s1cc" devirt "$out/linked.ll" -o "$out/devirt.ll")
    if [ "$ndv" -gt 0 ]; then
        echo "devirt: $ndv indirect call(s) made direct"
        "$LLVM_BIN/opt" -S -passes='default<O2>' -inline-threshold=100000 -jump-threading-threshold=0 -vectorize-loops=false -vectorize-slp=false \
            "$out/devirt.ll" -o "$out/linked.ll"
    fi
    # loops with a data-dependent trip count: profile the counts, peel to the maximum (docs/S1CC.md §4.5)
    nloops=$("$HERE/build/s1cc" trips "$out/linked.ll" -o "$out/trips.ll")
    if [ "$nloops" -gt 0 ]; then
        $CLANG -O1 -w "$out/trips.ll" "$HERE/runtime/s1rt.c" -lm -o "$out/trips" || fail E011 "link failed"
        "$out/trips" prof "$out/trips.txt"
        "$HERE/build/s1cc" unroll "$out/linked.ll" --trips "$out/trips.txt" -o "$out/voice.ll" > "$out/loops.txt"
        cat "$out/loops.txt"
    else
        cp "$out/linked.ll" "$out/voice.ll"
    fi
    "$HERE/build/s1cc" prof "$out/voice.ll" -o "$out/prof.ll"
    $CLANG -O1 -w "$out/linked.ll" "$HERE/runtime/s1rt.c" -lm -o "$out/ref" || fail E011 "link failed"   # loops as written
    $CLANG -O1 -w "$out/prof.ll" "$HERE/runtime/s1rt.c" -lm -o "$out/prof" || fail E011 "link failed"
    "$out/ref" tables "$out/tables.txt"
    "$out/prof" prof "$out/profile.txt"
    "$out/prof" sweep "$out/sweep.txt"         # every knob over 0..255: the knob-derived columns (docs/S1CC.md §4.6)
    "$HERE/build/s1cc" lower "$out/voice.ll" --profile "$out/profile.txt" --tables "$out/tables.txt" --sweep "$out/sweep.txt" \
        -o "$out/voice.s1k" --report "$out/report.txt" $lower_opts
    "$HERE/build/s1cc" init "$out/voice.ll" --kernel "$out/voice.s1k" --into "$out/linked.ll" -o "$out/refdsp.ll"
    $CLANG -O1 -w "$out/refdsp.ll" "$HERE/runtime/s1rt.c" -lm -o "$out/refdsp"
    echo "kernel: $out/voice.s1k"
    [ "$check" = 0 ] || python3 "$HERE/tools/s1check.py" "$out"
    ;;
deps)
    mkdir -p "$HERE/lib"
    EUR=${EURORACK:-$HOME/git/eurorack}
    PIN=$(git -C "$EUR" submodule status stmlib 2>/dev/null | awk '{print $1}' | tr -d '+-')
    [ -d "$HERE/lib/stmlib/.git" ] || git clone -q https://github.com/pichenettes/stmlib.git "$HERE/lib/stmlib"
    [ -n "$PIN" ] && git -C "$HERE/lib/stmlib" checkout -q "$PIN"
    echo "stmlib: $HERE/lib/stmlib $(git -C "$HERE/lib/stmlib" log --oneline -1)"
    ;;
check)
    [ $# -ge 1 ] || usage
    exec python3 "$HERE/tools/s1check.py" "$@"
    ;;
*) usage ;;
esac
